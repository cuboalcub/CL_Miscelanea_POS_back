meta {
  name: Actualizar Usuario
  type: http
  seq: 4
}

patch {
  url: {{base_url}}/usuarios/{{usuario_id}}
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{jwt_token}}
}

vars:pre-request {
  usuario_id: 00000000-0000-0000-0000-000000000000
}

body:json {
  {
    "nombre": "Carlos López Actualizado",
    "activo": true
  }
}
