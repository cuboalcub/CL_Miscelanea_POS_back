meta {
  name: Actualizar Perfil
  type: http
  seq: 5
}

patch {
  url: {{base_url}}/perfiles/{{perfil_id}}
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{jwt_token}}
}

vars:pre-request {
  perfil_id: 00000000-0000-0000-0000-000000000000
}

body:json {
  {
    "nivel": "admin",
    "activo": true
  }
}
