meta {
  name: Actualizar Sucursal
  type: http
  seq: 4
}

patch {
  url: {{base_url}}/sucursales/{{sucursal_id}}
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{jwt_token}}
}

body:json {
  {
    "telefono": "555-999-8888",
    "encargado": "Juan Pérez"
  }
}

vars:pre-request {
  sucursal_id: 20000000-2000-2000-2000-000000000015
}
